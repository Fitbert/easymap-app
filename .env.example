# Copy this file to .env and fill in real values. Never commit .env.
#
# Google Cloud Console > APIs & Services > Credentials
# Needs Maps SDK for Android, Maps SDK for iOS, and Directions API enabled.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Firebase console > Project settings > General > Your apps > Web app.
# (Just the client config — never put a service account / admin key here.)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Deliberately not using measurementId / Firebase Analytics — no analytics SDKs per spec.
